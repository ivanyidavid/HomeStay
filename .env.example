# Database Configuration
# Get from Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname

# Google Sheets Configuration
# API Key - create in Google Cloud Console with Sheets API enabled
GOOGLE_SHEETS_API_KEY=AIzaSy_YOUR_API_KEY_HERE

# Google Sheets ID - the ID from the URL of your Google Sheet
# Example: https://docs.google.com/spreadsheets/d/1xKU0YZdo.../edit#gid=0
GOOGLE_SHEETS_ID=1xKU0YZdoOWrhEKOeBVPVLO-U9IYzTE6m6pKuOTc6-ZM

# Email Configuration
# For Gmail: Use an App Password (not your regular password)
# Generate here: https://myaccount.google.com/apppasswords
EMAIL_USER=noreply@your-domain.com
EMAIL_PASS=your-app-specific-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Session Management (optional, if using authentication)
SESSION_SECRET=your-very-secure-random-secret-key

# Optional: Redis/Cache Configuration
# For caching Google Sheets data
# REDIS_URL=redis://default:password@host:port

# Optional: Vercel KV Configuration
# KV_URL=redis://...
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
